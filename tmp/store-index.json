{
  "sections": {
    "dys_hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.dys-hero{position:relative;overflow:hidden;color:#fff;background:radial-gradient(900px 480px at 88% 15%,rgba(124,92,255,.38),transparent 60%),radial-gradient(700px 420px at 5% 95%,rgba(0,200,255,.22),transparent 60%),#0b0d14}\n.dys-hero__inner{max-width:1240px;margin:0 auto;padding:56px 24px 60px;display:grid;grid-template-columns:1.05fr 1fr;gap:40px;align-items:center}\n.dys-hero h1{font-size:clamp(36px,5.4vw,66px);line-height:1.02;margin:0 0 16px;color:#fff;letter-spacing:-.02em}\n.dys-holo{background:linear-gradient(90deg,#5ee7ff,#a78bfa,#ff7ad9,#ffd36e);-webkit-background-clip:text;background-clip:text;color:transparent}\n.dys-hero p{color:rgba(255,255,255,.8);font-size:17px;line-height:1.55;max-width:46ch;margin:0 0 24px}\n.dys-btns{display:flex;flex-wrap:wrap;gap:10px}\n.dys-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 22px;border-radius:999px;font-weight:700;text-decoration:none;font-size:15px;transition:transform .15s ease}\n.dys-btn:hover{transform:translateY(-2px)}\n.dys-btn--primary{background:#fff;color:#0b0d14}\n.dys-btn--ghost{border:1px solid rgba(255,255,255,.4);color:#fff}\n.dys-links{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:18px;font-size:14.5px}\n.dys-links a{color:rgba(255,255,255,.88);text-decoration:underline;text-underline-offset:3px;text-decoration-color:rgba(255,255,255,.35)}\n.dys-links a:hover{text-decoration-color:#fff}\n.dys-offer{display:inline-flex;align-items:center;gap:10px;margin-top:20px;padding:9px 14px;border-radius:12px;background:rgba(255,255,255,.08);border:1px dashed rgba(255,255,255,.35);font-size:14px;color:rgba(255,255,255,.9)}\n.dys-offer code{font-family:inherit;font-weight:800;letter-spacing:.06em;color:#ffd36e}\n.dys-hero__art{position:relative;height:430px}\n.dys-hero__art a{position:absolute;display:block;width:54%;color:#0b0d14;text-decoration:none;transition:transform .25s ease}\n.dys-hero__art img{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:contain;border-radius:16px;box-shadow:0 24px 60px rgba(0,0,0,.55);background:#fff;padding:6%}\n.dys-hero__art a:nth-child(1){left:0;top:9%;transform:rotate(-7deg)}\n.dys-hero__art a:nth-child(2){right:0;top:0;transform:rotate(6deg);z-index:2}\n.dys-hero__art a:nth-child(3){left:25%;bottom:0;width:44%;transform:rotate(-1deg);z-index:3}\n.dys-hero__art a:hover{transform:rotate(0) translateY(-6px);z-index:4}\n.dys-price{position:absolute;right:10px;bottom:10px;padding:5px 11px;border-radius:999px;background:#0b0d14;color:#fff;font-size:13.5px;font-weight:800;box-shadow:0 6px 16px rgba(0,0,0,.35)}\n.dys-price s{opacity:.6;font-weight:600;margin-right:5px}\n@media(max-width:749px){.dys-hero__inner{grid-template-columns:1fr;padding:30px 16px 34px;gap:22px}.dys-hero__art{height:250px;max-width:360px;width:100%;margin:0 auto}.dys-hero p{font-size:16px;margin-bottom:20px}.dys-btn{padding:12px 18px;font-size:14px}.dys-price{font-size:11.5px;padding:3px 8px;right:6px;bottom:6px}}\n@media(prefers-reduced-motion:reduce){.dys-btn,.dys-hero__art a{transition:none}}\n</style>\n<div class=\"dys-hero\"><div class=\"dys-hero__inner\">\n<div>\n<h1>Your next pull starts <span class=\"dys-holo\">here.</span></h1>\n<p>Factory-sealed Pokémon, One Piece and more, hand-picked singles, sneakers and collectibles from a collector-run shop in Las Vegas. Every card price is checked against the market each night.</p>\n<div class=\"dys-btns\">\n<a class=\"dys-btn dys-btn--primary\" href=\"/collections/sealed-product\">Shop Pokémon</a>\n<a class=\"dys-btn dys-btn--primary\" href=\"/collections/one-piece-sealed\">Shop One Piece</a>\n<a class=\"dys-btn dys-btn--ghost\" href=\"/collections/new-shoes\">Sneakers</a>\n</div>\n<div class=\"dys-links\"><a href=\"https://market.driveyourstyle.net/\">Check what your cards are worth</a><a href=\"https://market.driveyourstyle.net/sell.html\">Sell us your cards</a></div>\n<div class=\"dys-offer\">New here? <span><code>WELCOME5</code> = $5 off your first $25+ order</span></div>\n</div>\n<div class=\"dys-hero__art\">\n{%- assign hero_handles = 'pitch-black-elite-trainer-box,one-piece-card-game-illustration-box-vol-6,mega-charizard-tin-mega-charizard-x,ascended-heroes-elite-trainer-box,30th-celebration-elite-trainer-box' | split: ',' -%}\n{%- assign shown = '' -%}{%- assign n = 0 -%}\n{%- for h in hero_handles -%}{%- assign p = all_products[h] -%}{%- if p.available and p.featured_image and n < 3 -%}{%- assign n = n | plus: 1 -%}{%- assign shown = shown | append: ',' | append: p.handle -%}<a href=\"{{ p.url }}\">{{ p.featured_image | image_url: width: 700 | image_tag: loading: 'eager', alt: p.title, sizes: '(max-width: 749px) 60vw, 30vw', widths: '360,500,700' }}<span class=\"dys-price\">{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}{{ p.price | money_without_trailing_zeros }}</span></a>{%- endif -%}{%- endfor -%}\n{%- if n < 3 -%}{%- assign fill = collections['sealed-product'].products | sort: 'price' | reverse -%}{%- for p in fill -%}{%- if n >= 3 -%}{%- break -%}{%- endif -%}{%- unless shown contains p.handle -%}{%- if p.available and p.featured_image -%}{%- assign n = n | plus: 1 -%}<a href=\"{{ p.url }}\">{{ p.featured_image | image_url: width: 700 | image_tag: loading: 'eager', alt: p.title, sizes: '(max-width: 749px) 60vw, 30vw', widths: '360,500,700' }}<span class=\"dys-price\">{{ p.price | money_without_trailing_zeros }}</span></a>{%- endif -%}{%- endunless -%}{%- endfor -%}{%- endif -%}\n</div>\n</div></div>\n",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "dys_trust": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.dys-trust{max-width:1240px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}\n.dys-trust__item{display:flex;gap:12px;align-items:center;padding:14px 16px;border-radius:14px;border:1px solid rgba(var(--color-foreground),.12)}\n.dys-trust__icon{flex:0 0 36px;height:36px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,#5ee7ff,#a78bfa)}\n.dys-trust__icon svg{width:18px;height:18px;stroke:#0b0d14}\n.dys-trust strong{display:block;font-size:14px;line-height:1.25;color:rgb(var(--color-foreground))}\n.dys-trust span{display:block;font-size:12px;line-height:1.35;color:rgba(var(--color-foreground),.68)}\n@media(max-width:989px){.dys-trust{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:749px){.dys-trust{padding:0 16px;gap:8px}.dys-trust__item{padding:10px;gap:9px;align-items:flex-start}.dys-trust__icon{flex-basis:30px;height:30px;border-radius:8px}.dys-trust__icon svg{width:15px;height:15px}.dys-trust strong{font-size:13px}.dys-trust span{font-size:11.5px}}\n</style>\n<div class=\"dys-trust\"><div class=\"dys-trust__item\"><div class=\"dys-trust__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg></div><div><strong>100% authentic</strong><span>Factory-sealed TCG, genuine sneakers</span></div></div><div class=\"dys-trust__item\"><div class=\"dys-trust__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 8l-9-5-9 5 9 5 9-5z\"/><path d=\"M3 8v8l9 5 9-5V8\"/></svg></div><div><strong>Ships in 2–3 days</strong><span>Singles sleeved, boxes padded</span></div></div><div class=\"dys-trust__item\"><div class=\"dys-trust__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg></div><div><strong>Free local pickup</strong><span>Las Vegas, by arrangement</span></div></div><div class=\"dys-trust__item\"><div class=\"dys-trust__icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v18h18\"/><path d=\"M7 15l4-4 3 3 6-6\"/></svg></div><div><strong>Fair prices</strong><span>Checked nightly against the market</span></div></div></div>\n",
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 8
      }
    },
    "dys_categories": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.dys-cats{max-width:1240px;margin:0 auto;padding:0 24px}\n.dys-cats__head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:0 0 18px}\n.dys-cats__head h2{margin:0}\n.dys-cats__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.dys-cat{--a:#1d3fa8;--b:#2b6de0;--c:#f2c230;position:relative;display:block;aspect-ratio:16/10;border-radius:20px;overflow:hidden;text-decoration:none;color:#fff;isolation:isolate;background:linear-gradient(135deg,var(--a) 0%,var(--b) 58%,var(--c) 130%);box-shadow:0 1px 0 rgba(255,255,255,.15) inset;transition:transform .2s ease,box-shadow .2s ease}\n.dys-cat:before{content:\"\";position:absolute;inset:0;z-index:-1;background:radial-gradient(120% 90% at 100% 0%,rgba(255,255,255,.28),transparent 55%),repeating-linear-gradient(135deg,rgba(255,255,255,.05) 0 2px,transparent 2px 14px)}\n.dys-cat:after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:62%;z-index:1;background:linear-gradient(to top,rgba(0,0,0,.55),transparent)}\n.dys-cat:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(0,0,0,.22)}\n.dys-cat__art{position:absolute;top:8%;right:4%;width:62%;height:72%}\n.dys-cat__art span{position:absolute;top:0;width:52%;aspect-ratio:1/1;border-radius:12px;background:#fff;box-shadow:0 14px 30px rgba(0,0,0,.35);overflow:hidden;transition:transform .25s ease}\n.dys-cat__art img{width:100%;height:100%;object-fit:contain;padding:6px;display:block}\n.dys-cat__art span:nth-child(1){right:0;transform:rotate(8deg);z-index:1}\n.dys-cat__art span:nth-child(2){right:26%;top:10%;transform:rotate(-4deg);z-index:2}\n.dys-cat__art span:nth-child(3){right:52%;top:20%;transform:rotate(-12deg);z-index:0;width:46%}\n.dys-cat:hover .dys-cat__art span:nth-child(1){transform:rotate(12deg) translateY(-4px)}\n.dys-cat:hover .dys-cat__art span:nth-child(3){transform:rotate(-16deg) translateY(-4px)}\n.dys-cat__t{position:absolute;left:18px;right:18px;bottom:16px;z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:10px}\n.dys-cat__t strong{display:block;font-size:24px;line-height:1.05;font-weight:800;letter-spacing:-.01em;text-shadow:0 2px 12px rgba(0,0,0,.35)}\n.dys-cat__t small{display:block;margin-top:4px;font-size:13px;opacity:.85}\n.dys-cat__go{flex:0 0 auto;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#0b0d14;font-weight:800;font-size:16px;transition:transform .2s ease}\n.dys-cat:hover .dys-cat__go{transform:translateX(3px)}\n.dys-cat--sealed{--a:#0f2a7a;--b:#2b6de0;--c:#f2c230}\n.dys-cat--singles{--a:#2a1350;--b:#7c4dff;--c:#ff7ad9}\n.dys-cat--onepiece{--a:#5e0b1e;--b:#c8243f;--c:#f2b84b}\n.dys-cat--sneakers{--a:#0b0d14;--b:#2a2f3a;--c:#c6f432}\n.dys-cat--popmart{--a:#b0306f;--b:#ff7ad9;--c:#ffd36e}\n.dys-cat--squish{--a:#006d7a;--b:#00b3c7;--c:#a6ffcb}\n@media(max-width:989px){.dys-cats__grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:749px){\n  .dys-cats{padding:0 16px}.dys-cats__head h2{font-size:24px}\n  .dys-cats__grid{gap:10px}\n  .dys-cat{aspect-ratio:1/1.05;border-radius:16px}\n  .dys-cat__art{top:7%;right:6%;width:88%;height:58%}\n  .dys-cat__art span{border-radius:9px;width:50%}\n  .dys-cat__art span:nth-child(3){width:44%}\n  .dys-cat__t{left:12px;right:12px;bottom:12px}\n  .dys-cat__t strong{font-size:17px}\n  .dys-cat__t small{font-size:11.5px}\n  .dys-cat__go{width:28px;height:28px;font-size:13px}\n}\n</style>\n<div class=\"dys-cats\"><div class=\"dys-cats__head\"><h2 class=\"h1\">Shop by category</h2></div><div class=\"dys-cats__grid\">\n{%- assign cat_handles = \"sealed-product,singles,one-piece-sealed,new-shoes,collectibles,squishies\" | split: \",\" -%}\n{%- assign cat_names = \"Pokémon Sealed|Pokémon Singles|One Piece TCG|Sneakers|Pop Mart & Toys|Squishies\" | split: \"|\" -%}\n{%- assign cat_cls = \"sealed,singles,onepiece,sneakers,popmart,squish\" | split: \",\" -%}\n{%- for h in cat_handles -%}{%- assign col = collections[h] -%}{%- if col.products_count > 0 -%}\n{%- assign i = forloop.index0 -%}\n<a class=\"dys-cat dys-cat--{{ cat_cls[i] }}\" href=\"{{ col.url }}\" aria-label=\"Shop {{ cat_names[i] }}\">\n<span class=\"dys-cat__art\" aria-hidden=\"true\">\n{%- assign picks = col.products | sort: 'price' | reverse -%}{%- assign n = 0 -%}\n{%- for p in picks -%}{%- if n >= 3 -%}{%- break -%}{%- endif -%}{%- if p.available and p.featured_image -%}{%- assign n = n | plus: 1 -%}<span>{{ p.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '', widths: '180,240,360', sizes: '(max-width: 749px) 25vw, 160px' }}</span>{%- endif -%}{%- endfor -%}\n</span>\n<span class=\"dys-cat__t\"><span><strong>{{ cat_names[i] }}</strong><small>{{ col.products_count }} item{% if col.products_count != 1 %}s{% endif %}</small></span><span class=\"dys-cat__go\">→</span></span>\n</a>\n{%- endif -%}{%- endfor -%}\n</div></div>\n",
        "color_scheme": "scheme-1",
        "padding_top": 28,
        "padding_bottom": 20
      }
    },
