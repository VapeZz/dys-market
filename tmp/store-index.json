    "dys_insights": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.dys-mi{max-width:1240px;margin:0 auto;padding:0 24px}\n.dys-mi__card{border-radius:20px;padding:40px;color:#fff;display:grid;grid-template-columns:1.4fr 1fr;gap:24px;align-items:center;background:linear-gradient(120deg,#0b0d14 0%,#1a1440 55%,#3b1d5e 100%);position:relative;overflow:hidden}\n.dys-mi__card:after{content:\"\";position:absolute;inset:auto -80px -120px auto;width:340px;height:340px;border-radius:50%;background:conic-gradient(from 0deg,#5ee7ff,#a78bfa,#ff7ad9,#ffd36e,#5ee7ff);filter:blur(60px);opacity:.35}\n.dys-mi__eb{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#5ee7ff;font-weight:700}\n.dys-mi h2{color:#fff;margin:8px 0 10px;font-size:clamp(26px,3vw,38px)}\n.dys-mi p{color:rgba(255,255,255,.8);margin:0;font-size:16px;line-height:1.55}\n.dys-mi__cta{justify-self:end;position:relative;z-index:1;display:flex;flex-direction:column;gap:10px;align-items:stretch}\n.dys-mi__cta a{display:inline-flex;justify-content:center;padding:13px 22px;border-radius:999px;font-weight:700;text-decoration:none}\n.dys-mi__cta a.p{background:#fff;color:#0b0d14}\n.dys-mi__cta a.g{border:1px solid rgba(255,255,255,.4);color:#fff}\n@media(max-width:749px){.dys-mi{padding:0 16px}.dys-mi__card{grid-template-columns:1fr;padding:26px 22px}.dys-mi__cta{justify-self:stretch}}\n</style>\n<div class=\"dys-mi\"><div class=\"dys-mi__card\">\n<div><span class=\"dys-mi__eb\">● Updated nightly</span><h2>Know the market before you rip</h2><p>Free market prices on 70,000+ cards and sealed products across Pokémon, One Piece, Lorcana, Riftbound, Gundam, Union Arena and more. Scan a card with your camera, see what's trending, browse every set and track what your collection is worth.</p></div>\n<div class=\"dys-mi__cta\"><a class=\"p\" href=\"https://market.driveyourstyle.net/\">Check prices →</a><a class=\"g\" href=\"https://market.driveyourstyle.net/collection.html\">Track my collection</a><a class=\"g\" href=\"https://market.driveyourstyle.net/sell.html\">Sell us your cards</a></div>\n</div></div>\n",
        "color_scheme": "scheme-1",
        "padding_top": 32,
        "padding_bottom": 32
      }
